@{
    int code = ViewBag.Code ?? 404;
    ViewData["Title"] = code == 404 ? "Page not found" : "Something went wrong";
}
<div class="empty">
    <div class="big-code">@code</div>
    <h1>@(code == 404 ? "Page not found" : "Something went wrong")</h1>
    <p class="muted">@(code == 404 ? "That page doesn't exist or has moved." : "Please try again in a moment.")</p>
    <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to events</a>
</div>
