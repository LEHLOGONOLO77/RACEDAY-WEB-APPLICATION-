@{
    var user = Context.Session.GetUser();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] is string t ? t + " · " : "")RaceDay</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
    <header class="rd-nav">
        <div class="container rd-nav-inner">
            <a class="rd-brand" asp-controller="@(user?.IsOrganiser == true ? "Organiser" : "Home")" asp-action="Index">RACE<span>DAY</span></a>

            <button class="rd-burger" type="button" aria-label="Menu" data-nav-toggle>
                <span></span><span></span>
            </button>

            <nav class="rd-links" data-nav>
                @if (user is null)
                {
                    <a asp-controller="Home" asp-action="Index">Events</a>
                    <span class="rd-spacer"></span>
                    <a asp-controller="Account" asp-action="Login">Log in</a>
                    <a class="btn btn-rd btn-sm" asp-controller="Account" asp-action="Register">Sign up</a>
                }
                else if (user.IsOrganiser)
                {
                    <a asp-controller="Organiser" asp-action="Index">Dashboard</a>
                    <a asp-controller="OrganiserEvents" asp-action="Index">Events</a>
                    <span class="rd-spacer"></span>
                    <span class="rd-user"><em>Organiser</em> @user.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="rd-link-btn">Sign out</button></form>
                }
                else
                {
                    <a asp-controller="Home" asp-action="Index">Events</a>
                    <a asp-controller="Enrolments" asp-action="Index">My enrolments</a>
                    <a asp-controller="Results" asp-action="Index">My results</a>
                    <a asp-controller="Profile" asp-action="Index">Profile</a>
                    <span class="rd-spacer"></span>
                    <span class="rd-user"><em>Participant</em> @user.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button class="rd-link-btn">Sign out</button></form>
                }
            </nav>
        </div>
    </header>

    <main class="container rd-main">
        <partial name="_Alerts" />
        @RenderBody()
    </main>

    <footer class="rd-footer">
        <div class="container">RACE<span>DAY</span> · Run. Walk. Ride.</div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
