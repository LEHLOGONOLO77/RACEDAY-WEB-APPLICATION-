@model HomeVm
@{ ViewData["Title"] = "Upcoming events"; }

<section class="hero">
    <h1>Find your next <span>race.</span></h1>
    <p class="muted">Runs, walks and rides coming up. Pick one and enrol in a minute.</p>
</section>

<form method="get" asp-action="Index" class="filters">
    <div class="field">
        <label for="q">Search</label>
        <input id="q" name="q" value="@Model.Q" class="form-control" placeholder="Name or location" />
    </div>
    <div class="field">
        <label for="type">Type</label>
        <select id="type" name="type" class="form-select">
            <option value="">All types</option>
            @foreach (var t in Lookups.EventTypes)
            {
                <option value="@t" selected="@(Model.Type == t)">@t</option>
            }
        </select>
    </div>
    <div class="field">
        <label for="from">From</label>
        <input id="from" name="from" type="date" value="@Model.From?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="field">
        <label for="to">To</label>
        <input id="to" name="to" type="date" value="@Model.To?.ToString("yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-rd">Filter</button>
        @if (Model.Filtered)
        {
            <a class="btn btn-line" asp-action="Index">Clear</a>
        }
    </div>
</form>

@if (Model.Events.Count == 0)
{
    <div class="empty-inline">
        @(Model.Filtered ? "No events match those filters." : "No upcoming events right now. Check back soon.")
    </div>
}
else
{
    <div class="ev-grid">
        @foreach (var ev in Model.Events)
        {
            <partial name="_EventCard" model="ev" />
        }
    </div>
}
